---
import { primaryNav, site } from "../config";
import BrandMark from "./BrandMark.astro";

interface Props { current?: string }
const { current } = Astro.props;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <BrandMark />
      <span class="wordmark"><b>{site.name}</b><small>{site.tagline}</small></span>
    </a>

    <nav class="nav" aria-label="Primary">
      {primaryNav.map((item) => (
        <a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="utility">
      <div class="lang" aria-label="Language">
        <button type="button" aria-pressed="true">EN</button><span>/</span><button type="button" aria-pressed="false">SW</button>
      </div>
      <a class="btn btn-teal btn-sm btn-brutal" href="/get-help" aria-label="Get help" aria-current={current === "get-help" ? "page" : undefined}>
        <svg class="bic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7.6L7 19.5V16H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm3 5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm4 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm4 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/></svg>
        <span class="btxt">Get help</span>
      </a>
      <a class="btn btn-help btn-sm btn-donate btn-brutal" href="/get-involved#donate" aria-label="Donate">
        <svg class="bic heart" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 20.8 4.6 13.3a4.7 4.7 0 0 1 0-6.6 4.7 4.7 0 0 1 6.6 0l.8.8.8-.8a4.7 4.7 0 0 1 6.6 0 4.7 4.7 0 0 1 0 6.6Z"/></svg>
        <span class="btxt">Donate</span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>
