---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const u = (id: string, w: number) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&q=80&w=${w}`;
const fallback = u("photo-1567095199396-d4e5588a3cb8", 1600);

const cover = post.data.coverPhoto || fallback;
const coverAlt = post.data.coverPhotoAlt || "A path toward open ground and the morning light.";

const catColor = (cat: string) =>
  cat === "Announcement" || cat === "Story" ? "purplebright" : "teal";

const formatDate = (d: string) => {
  const [y, m, day] = d.split("-").map(Number);
  return new Date(y, m - 1, day).toLocaleDateString("en-GB", {
    day: "numeric", month: "long", year: "numeric",
  });
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  current="updates"
>
  <Hero
    variant="soft"
    labelledby="post-h"
    image={cover}
    alt={coverAlt}
  >
    <span class="label" style={`color:var(--${catColor(post.data.category)}-lt)`}>{post.data.category}</span>
    <h1 class="display" id="post-h" style="margin-top:0.6rem">{post.data.title}</h1>
    <p class="label" style="color:rgba(239,234,221,0.65);margin-top:0.8rem;letter-spacing:0.04em">
      {formatDate(post.data.date)}&ensp;·&ensp;{post.data.author}
    </p>
  </Hero>

  <!-- Article body -->
  <section class="section" aria-labelledby="post-h">
    <div class="wrap measure">
      <div class="article-body">
        <Content />
      </div>
    </div>
  </section>

  <!-- Divider: back to listing + CTA -->
  <section class="section band" aria-label="Continue reading">
    <div class="wrap">
      <div class="post-footer">
        <div data-reveal>
          <a class="arrow flip-arrow" href="/updates">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            All updates
          </a>
        </div>
        <div data-reveal="2">
          <span class="label">Stand with us</span>
          <h2 class="h3" style="margin-top:0.5rem">What you do next matters.</h2>
          <div class="hero-cta" style="margin-top:1.1rem">
            <a class="btn btn-help" href="/get-help">Get support</a>
            <a class="btn btn-purplebright" href="/get-involved#donate">Donate</a>
            <a class="btn btn-outline" href="/get-involved#partnerships">Partner with us</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* Editorial prose for rendered Markdown content */
.article-body {
  --prose-gap: 1.15rem;
}

.article-body :global(p) {
  color: var(--ink-soft);
  line-height: 1.78;
  margin: 0 0 var(--prose-gap);
}

.article-body :global(p:first-of-type) {
  font-size: clamp(1.05rem, 2vw, 1.18rem);
  color: var(--ink);
  line-height: 1.7;
}

.article-body :global(h2) {
  font-family: var(--display);
  font-size: clamp(1.35rem, 3vw, 1.8rem);
  color: var(--ink);
  line-height: 1.2;
  margin: 2.5rem 0 0.7rem;
}

.article-body :global(h3) {
  font-family: var(--display);
  font-size: clamp(1.1rem, 2.5vw, 1.4rem);
  color: var(--ink);
  line-height: 1.25;
  margin: 2rem 0 0.6rem;
}

.article-body :global(ul),
.article-body :global(ol) {
  margin: 0 0 var(--prose-gap);
  padding: 0;
  list-style: none;
  display: grid;
  gap: 0.55rem;
}

.article-body :global(li) {
  padding-left: 1.5rem;
  position: relative;
  color: var(--ink-soft);
  line-height: 1.7;
}

.article-body :global(ul li::before) {
  content: "—";
  position: absolute;
  left: 0;
  color: var(--purpleblue-deep);
  font-weight: 600;
}

.article-body :global(ol) {
  counter-reset: li;
}

.article-body :global(ol li) {
  counter-increment: li;
}

.article-body :global(ol li::before) {
  content: counter(li) ".";
  position: absolute;
  left: 0;
  color: var(--purpleblue-deep);
  font-weight: 600;
  font-family: var(--display);
}

.article-body :global(strong) {
  color: var(--ink);
  font-weight: 600;
}

.article-body :global(em) {
  font-style: italic;
}

.article-body :global(blockquote) {
  margin: 2rem 0;
  padding: 0;
  border: none;
}

.article-body :global(blockquote p) {
  font-family: var(--display);
  font-size: clamp(1.2rem, 3vw, 1.65rem);
  color: var(--ink);
  line-height: 1.3;
  font-style: italic;
}

.article-body :global(a) {
  color: var(--purpleblue-deep);
  text-decoration: underline;
  text-underline-offset: 0.2em;
  text-decoration-thickness: 1px;
}

.article-body :global(a:hover) {
  color: var(--ink);
}

/* Inline images */
.article-body :global(img) {
  width: 100%;
  height: auto;
  display: block;
  margin: 2rem 0;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

/* Tables */
.article-body :global(table) {
  width: 100%;
  border-collapse: collapse;
  margin: 2rem 0;
  font-size: 0.9rem;
}

.article-body :global(th) {
  font-family: var(--display);
  font-size: 0.78rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink);
  text-align: left;
  padding: 0.6rem 1rem 0.6rem 0;
  border-bottom: 2px solid var(--purpleblue-deep);
}

.article-body :global(td) {
  padding: 0.65rem 1rem 0.65rem 0;
  color: var(--ink-soft);
  border-bottom: 1px solid rgba(0,0,0,0.07);
  vertical-align: top;
  line-height: 1.5;
}

.article-body :global(tr:last-child td) {
  border-bottom: none;
}

.article-body :global(td strong),
.article-body :global(th strong) {
  color: var(--ink);
}

/* Horizontal rule */
.article-body :global(hr) {
  border: none;
  border-top: 1px solid rgba(0,0,0,0.1);
  margin: 2.5rem 0;
}

/* Figure captions (images with alt text shown as italic below) */
.article-body :global(em) {
  font-style: italic;
  color: var(--ink-soft);
}

/* Table note (italic paragraph immediately after a table) */
.article-body :global(table + p em) {
  font-size: 0.82rem;
  color: var(--ink-xsoft, rgba(30,30,30,0.45));
}

/* Post footer: back link left, CTA right */
.post-footer {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: start;
}

@media (max-width: 660px) {
  .post-footer {
    grid-template-columns: 1fr;
  }
}

.flip-arrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  font-family: var(--display);
  font-size: 0.95rem;
  letter-spacing: 0.02em;
  color: var(--ink-soft);
  transition: color 0.2s;
}

.flip-arrow:hover {
  color: var(--ink);
}

.flip-arrow svg {
  width: 1.1em;
  height: 1.1em;
  flex-shrink: 0;
}
</style>
