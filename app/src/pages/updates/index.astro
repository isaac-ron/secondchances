---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";

const u = (id: string, w: number) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&q=80&w=${w}`;
const heroId = "photo-1499750310107-5fef28a66643"; // editorial writing desk

const allPosts = (await getCollection("posts")).sort((a, b) => {
  const diff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  return diff !== 0 ? diff : a.data.order - b.data.order;
});

const featured = allPosts.find((p) => p.data.featured);
const rest = allPosts.filter((p) => p !== featured);

const catColor = (cat: string) =>
  cat === "Announcement" || cat === "Story" ? "purplebright" : "teal";

const formatDate = (d: string) => {
  const [y, m, day] = d.split("-").map(Number);
  return new Date(y, m - 1, day).toLocaleDateString("en-GB", {
    day: "numeric", month: "long", year: "numeric",
  });
};

const fallback = u("photo-1567095199396-d4e5588a3cb8", 1200);
---
<BaseLayout
  title="Updates & Announcements"
  description="Field notes, programme updates and announcements from Second Chances Kenya."
  current="updates"
>
  <Hero
    variant="soft"
    labelledby="updates-h"
    image={u(heroId, 1600)}
    srcset={`${u(heroId, 1200)} 1200w, ${u(heroId, 1600)} 1600w, ${u(heroId, 2000)} 2000w`}
    alt="An open notebook and pen on a desk in warm morning light."
  >
    <span class="label" style="color:var(--purplebright-lt)">Field notes</span>
    <h1 class="display" id="updates-h" style="margin-top:0.6rem">Updates from Second <em>Chances.</em></h1>
    <p class="hero-lead">Small, steady progress — shared honestly as it happens. Programme news, stories from the work, and accountability reports.</p>
  </Hero>

  {featured && (
    <section aria-labelledby="featured-h">
      <article class="split-bleed" data-reveal>
        <div class="media">
          <img
            src={featured.data.coverPhoto || fallback}
            srcset={featured.data.coverPhoto
              ? `${featured.data.coverPhoto.replace(/w=\d+/, "w=800")} 800w, ${featured.data.coverPhoto} 1600w`
              : undefined}
            sizes="(max-width: 940px) 100vw, 50vw"
            width="1200" height="900"
            loading="eager"
            alt={featured.data.coverPhotoAlt || featured.data.title}
          />
        </div>
        <div class="copy"><div class="inner">
          <span class="pillar-no">
            <span class="label" style={`color:var(--${catColor(featured.data.category)}-deep)`}>{featured.data.category}</span>
            <span class="label" style="color:var(--ink-faint);margin-left:0.6rem">{formatDate(featured.data.date)}</span>
          </span>
          <h2 class="h3" id="featured-h" style="margin-top:0.4rem">{featured.data.title}</h2>
          <p class="lead" style="margin-top:0.9rem">{featured.data.excerpt}</p>
          <p class="label" style="color:var(--ink-faint);margin-top:0.8rem">{featured.data.author}</p>
          <a class="arrow" href={`/updates/${featured.id}`} style="margin-top:1.4rem">
            Read the full update
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div></div>
      </article>
    </section>
  )}

  {rest.length > 0 && (
    <section class="section" aria-label="All updates">
      <div class="wrap">
        {featured && (
          <div class="head" style="margin-bottom:clamp(1.5rem,3vw,2.5rem)" data-reveal>
            <span class="label">More updates</span>
          </div>
        )}
        <div class="posts-grid">
          {rest.map((post, i) => (
            <article class="post-card" data-reveal={i > 0 ? String((i % 3) + 1) : undefined}>
              <a class="post-card-img" href={`/updates/${post.id}`} tabindex="-1" aria-hidden="true">
                <img
                  src={post.data.coverPhoto || fallback}
                  alt={post.data.coverPhotoAlt || post.data.title}
                  loading="lazy"
                  width="760" height="480"
                />
              </a>
              <div class="post-card-body">
                <div class="post-card-meta">
                  <span class="label" style={`color:var(--${catColor(post.data.category)}-deep)`}>{post.data.category}</span>
                  <span class="post-card-date">{formatDate(post.data.date)}</span>
                </div>
                <h3 style="margin:0.4rem 0 0.7rem">
                  <a href={`/updates/${post.id}`}>{post.data.title}</a>
                </h3>
                <p>{post.data.excerpt}</p>
                <a class="arrow" href={`/updates/${post.id}`} style="margin-top:1.1rem">
                  Read
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {allPosts.length === 0 && (
    <section class="section">
      <div class="wrap measure">
        <p class="lead">Updates coming soon. Check back shortly.</p>
      </div>
    </section>
  )}

  <!-- Closing -->
  <section class="mission" aria-label="Stay connected">
    <div class="wrap" data-reveal>
      <p class="q">Refuse to give up on a young person. Watch a life turn, quietly, <em>completely.</em></p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;justify-content:center">
        <a class="btn btn-help btn-lg" href="/get-help">Get support</a>
        <a class="btn btn-give btn-lg" href="/get-involved#donate">Stand with us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.posts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
  gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
}

.post-card {
  display: flex;
  flex-direction: column;
}

.post-card-img {
  display: block;
  overflow: hidden;
  aspect-ratio: 16 / 10;
}

.post-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.post-card:hover .post-card-img img {
  transform: scale(1.04);
}

.post-card-body {
  padding: 1.4rem 0 0;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.post-card-meta {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  margin-bottom: 0.1rem;
}

.post-card-date {
  font-size: 0.78rem;
  color: var(--ink-faint);
  font-family: var(--body);
}

.post-card-body h3 {
  font-family: var(--display);
  font-size: clamp(1.1rem, 2.2vw, 1.35rem);
  line-height: 1.25;
  color: var(--ink);
}

.post-card-body h3 a {
  text-decoration: none;
  color: inherit;
}

.post-card-body h3 a:hover {
  color: var(--purpleblue-deep);
}

.post-card-body p {
  color: var(--ink-soft);
  line-height: 1.65;
  flex: 1;
  margin: 0;
}
</style>
