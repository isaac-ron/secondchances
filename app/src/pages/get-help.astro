---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { contact } from "../config";

// Rendered on-demand so the form's success state (?sent=1) works.
export const prerender = false;
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;
const sent = Astro.url.searchParams.get("sent") === "1";

const u = (id: string, w: number) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&q=80&w=${w}`;
const door = "photo-1535556572967-276cd0ad5cba";
const hands = "photo-1574740637579-9ca0a610e491";
const tel = contact.generalPhone.replace(/\s/g, "");
---
<BaseLayout
  title="Get Help"
  description="Reaching out to Second Chances is confidential and simple. WhatsApp, call, or send a private message. You don't have to be in crisis to reach out."
  current="get-help"
>
  <Hero
    variant="soft"
    minHeight="72vh"
    labelledby="help-h"
    image={u(door, 1600)}
    srcset={`${u(door, 1200)} 1200w, ${u(door, 1600)} 1600w, ${u(door, 2000)} 2000w`}
    alt="An open door letting soft morning light into a quiet room."
  >
    <p class="kicker-line">You reached out. That took courage.</p>
    <h1 class="display" id="help-h">Let's take the next step <em>together.</em></h1>
    <p class="hero-lead">There is no wrong way to do this, and no situation too big or too small. Reach out however feels safest: you can stay anonymous, and nothing is shared without your say-so.</p>
    <p class="hero-foot">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
      On a shared or borrowed phone? <a href="https://www.google.com" data-exit>Leave this site now</a>, or press Esc.
    </p>
  </Hero>

  <!-- Channels -->
  <section class="section" style="padding-top:clamp(2.5rem,5vw,3.5rem)" aria-label="Ways to reach us">
    <div class="wrap">
      <div class="channels">
        <article class="channel" data-reveal>
          <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.6-1.2A9 9 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="M8.5 9.5c0 3 2.5 5.5 5.5 5.5l1-1.4-2-1-.8.8a4.2 4.2 0 0 1-1.9-1.9l.8-.8-1-2L8.5 9.5Z" fill="currentColor" /></svg>
          <h3>WhatsApp us</h3>
          <p>The simplest way to start: message at your own pace, any time. Text or voice note, whatever is easier.</p>
          <a class="btn btn-help go" href={`https://wa.me/${tel.replace(/^\+/, "")}`}>Open WhatsApp</a>
        </article>
        <article class="channel" data-reveal="2">
          <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l2 5-2 1.5a11 11 0 0 0 5 5L15 13l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
          <h3>Call or text</h3>
          <p>Speak to a real person who understands care-leaver experiences. Lines are answered during the day; leave a message any time.</p>
          <a class="btn btn-help go" href={`tel:${tel}`}>{contact.generalPhone}</a>
        </article>
        <article class="channel" data-reveal="3">
          <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="m4 6 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
          <h3>Send a private message</h3>
          <p>Prefer to write? Use the short form below. Only one field is required; you decide how much to share.</p>
          <a class="btn btn-help go" href="#form">Open the form</a>
        </article>
      </div>
    </div>
  </section>

  <!-- What to expect -->
  <section aria-labelledby="expect-h">
    <article class="split-bleed flip tint" data-reveal>
      <div class="media">
        <img src={u(hands, 1200)} srcset={`${u(hands, 800)} 800w, ${u(hands, 1200)} 1200w`}
             sizes="(max-width: 940px) 100vw, 50vw" width="1200" height="900" loading="lazy"
             alt="Two people's hands, one steadying the other against soft daylight." />
      </div>
      <div class="copy"><div class="inner">
        <span class="label">What to expect</span>
        <h2 class="h3" id="expect-h" style="margin-top:0.4rem">No forms, no judgement, no rush.</h2>
        <p class="lead" style="margin-top:0.9rem">You are in control the whole way. Here is exactly what happens when you reach out.</p>
        <ol class="steps">
          <li><span><b>You make contact.</b> Anonymously if you wish. There is no situation we will turn away.</span></li>
          <li><span><b>We listen first.</b> Someone who understands care reaches out simply to hear you, no assessment, no pressure.</span></li>
          <li><span><b>We find the next step together.</b> Counselling, education, legal aid, or just someone in your corner.</span></li>
          <li><span><b>We stay.</b> Support doesn't end after one call. A community that will not disappear.</span></li>
        </ol>
      </div></div>
    </article>
  </section>

  <!-- Our promise -->
  <section class="section" aria-labelledby="promise-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="label">Our promise to you</span>
        <h2 class="h2 title" id="promise-h" style="margin-top:0.5rem">Three things you can count on.</h2>
      </div>
      <div class="reassure" data-reveal>
        <div><h4>It stays private</h4><p>What you tell us is confidential and handled with care. Nothing is passed on without your consent, except where someone is in danger.</p></div>
        <div><h4>It's never too late</h4><p>Whether you left care last week or years ago, this door is open. You don't have to be in crisis to reach out.</p></div>
        <div><h4>You set the pace</h4><p>Ask one question or share your whole story. Come back tomorrow, next month, or never; there is no wrong choice here.</p></div>
      </div>
    </div>
  </section>

  <!-- Private message form -->
  <section class="section band" id="form" aria-labelledby="form-h" style="scroll-margin-top:5.5rem">
    <div class="wrap measure">
      <span class="label">Write to us</span>
      <h2 class="h2 title" id="form-h" style="margin-top:0.5rem">Send a private message.</h2>
      <p class="lead" style="margin-top:0.9rem">Tell us as little or as much as you like.</p>

      {sent ? (
        <p class="callout teal" style="margin-top:1rem">Thank you for trusting us. Someone will read this with care.</p>
      ) : (
        <form method="POST" action="/api/get-help" style="display:grid;gap:1.3rem;margin-top:1.4rem">
          <label style="display:grid;gap:.5rem">
            <span class="label" style="color:var(--ink-soft)">What's on your mind? <em style="color:var(--purplebright-deep);font-style:normal">(required)</em></span>
            <textarea name="message" rows="4" required placeholder="You can write anything. Even just 'I don't know where to start' is enough."></textarea>
          </label>
          <label style="display:grid;gap:.5rem">
            <span class="label" style="color:var(--ink-soft)">How can we reach you? <em style="font-style:italic;color:var(--ink-faint)">(optional, leave blank to stay anonymous)</em></span>
            <input type="text" name="contact" placeholder="Phone, WhatsApp, or email, only if you want a reply" />
          </label>
          {sitekey && <div class="cf-turnstile" data-sitekey={sitekey}></div>}
          <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
            <button type="submit" class="btn btn-help btn-lg">Send privately</button>
            <span class="small muted">Encrypted in transit, stored securely, never sold or shared.</span>
          </div>
        </form>
      )}
    </div>
  </section>

  <!-- Not ready -->
  <section class="section center" aria-label="Resources">
    <div class="wrap measure">
      <p class="callout teal">Not ready to talk yet? That's okay. You can read practical guides on documentation, housing, work and your rights, quietly, on your own, no contact needed.</p>
      <a class="link-arrow" href="/resources">Browse resources and guides <span>&rarr;</span></a>
    </div>
  </section>

  {sitekey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
