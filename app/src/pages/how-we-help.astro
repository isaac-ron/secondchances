---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Faq from "../components/Faq.astro";

const u = (id: string, w: number) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&q=80&w=${w}`;
const hands = "photo-1574740637579-9ca0a610e491";

// Per-pillar art direction, keyed by the collection `anchor`.
const art: Record<string, { icon: string; tone: "teal" | "purplebright"; essence: string; photo: string }> = {
  counselling: { icon: "013-social-care", tone: "teal", essence: "Healing", photo: "photo-1574740637579-9ca0a610e491" },
  education: { icon: "005-graduation-cap", tone: "purplebright", essence: "Learning", photo: "photo-1550592704-6c76defa9985" },
  "legal-aid": { icon: "004-balance", tone: "teal", essence: "Justice", photo: "photo-1632152133952-98b268dc4b86" },
  community: { icon: "012-group", tone: "purplebright", essence: "Belonging", photo: "photo-1582213782179-e0d53f98f2ca" },
};

const entries = (await getCollection("pillars")).sort((a, b) => a.data.order - b.data.order);
const pillars = await Promise.all(
  entries.map(async (p) => ({ ...p.data, Content: (await render(p)).Content }))
);
---
<BaseLayout
  title="How We Help"
  description="Counselling and healing, education and vocational training, legal aid, and a peer community: the same grace we would extend to our own children."
  current="how-we-help"
>
  <Hero
    variant="soft"
    labelledby="help-h"
    image={u(hands, 1600)}
    srcset={`${u(hands, 1200)} 1200w, ${u(hands, 1600)} 1600w, ${u(hands, 2000)} 2000w`}
    alt="Two people's hands, one holding the other steady against soft daylight."
  >
    <span class="label" style="color:var(--purplebright-lt)">How we help</span>
    <h1 class="display" id="help-h" style="margin-top:0.6rem">The same grace we'd extend to our <em>own children.</em></h1>
    <p class="hero-lead">Because that is exactly what they are. Four ways we stand with every young person who comes to us, only ever what you want, when you're ready.</p>
    <div class="hero-cta">
      <a class="btn btn-help btn-lg" href="/get-help">Talk to someone</a>
    </div>
  </Hero>

  <section class="pillars" aria-labelledby="pillars-h">
    <div class="wrap">
      <div class="head" data-reveal style="margin-block: clamp(2.5rem,5vw,4rem) clamp(1rem,2vw,1.5rem)">
        <span class="label">Four pillars</span>
        <h2 class="h2 title" id="pillars-h" style="margin-top:0.6rem">Support that meets you where you are.</h2>
        <p class="lead">Start anywhere. Most young people arrive through one door and find the others open too.</p>
      </div>
    </div>

    {pillars.map((p, i) => {
      const a = art[p.anchor] ?? { icon: "013-social-care", tone: "teal" as const, essence: "Support", photo: hands };
      const Body = p.Content;
      const flip = i % 2 === 0;
      return (
        <article class={`split-bleed${flip ? " flip" : ""}`} id={p.anchor} data-reveal style="scroll-margin-top:5.5rem">
          <div class="media">
            <img src={u(a.photo, 1200)} srcset={`${u(a.photo, 800)} 800w, ${u(a.photo, 1200)} 1200w`}
                 sizes="(max-width: 940px) 100vw, 50vw" width="1200" height="900" loading="lazy" alt={p.title} />
          </div>
          <div class="copy"><div class="inner">
            <span class="pillar-no"><span class={`picon ${a.tone}`} style={`--src:url(/icons/${a.icon}.png)`} aria-hidden="true"></span><span class="step">{a.essence}</span></span>
            <h3 class="h3">{p.title}</h3>
            <div class="pillar-body"><Body /></div>
            {p.bullets.length > 0 && (
              <ul class="trust-points" style="margin-top:1.3rem;gap:0.9rem">
                {p.bullets.map((b) => (
                  <li>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" style="color:var(--purpleblue-deep)" /><path d="M8 12l2.5 2.5L16 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--purpleblue-deep)" /></svg>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
            <a class="arrow" href="/get-help" style="margin-top:1.3rem">{p.cta} <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div></div>
        </article>
      );
    })}
  </section>

  <!-- FAQ -->
  <section class="section band" aria-labelledby="faq-h">
    <div class="wrap measure">
      <span class="label">Before you reach out</span>
      <h2 class="h2 title" id="faq-h" style="margin-top:0.5rem">Questions you might be asking.</h2>
      <Faq />
    </div>
  </section>

  <!-- Closing -->
  <section class="section band-ink center" aria-labelledby="help-close-h">
    <div class="wrap measure">
      <p class="display" id="help-close-h">Whatever you need, you don't have to ask for it <em>perfectly.</em></p>
      <div class="hero-cta closing-cta-buttons" style="justify-content:center">
        <a class="btn btn-help btn-lg" href="/get-help">Reach out now</a>
        <a class="btn btn-ghost btn-lg" href="/resources">Browse resources</a>
      </div>
    </div>
  </section>
</BaseLayout>
