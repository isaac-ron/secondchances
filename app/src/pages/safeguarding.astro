---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { contact } from "../config";

const u = (id: string, w: number) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&q=80&w=${w}`;
const hands = "photo-1582213782179-e0d53f98f2ca";
const door = "photo-1535556572967-276cd0ad5cba";
---
<BaseLayout
  title="Safeguarding"
  description="Our commitment to the safety and dignity of every young person: principles, code of conduct, how to report a concern, and how we handle your data."
>
  <Hero
    variant="soft"
    labelledby="safe-h"
    image={u(door, 1600)}
    srcset={`${u(door, 1200)} 1200w, ${u(door, 1600)} 1600w, ${u(door, 2000)} 2000w`}
    alt="An open door letting light into a quiet, sheltered room."
  >
    <span class="label" style="color:var(--purplebright-lt)">Safeguarding</span>
    <h1 class="display" id="safe-h" style="margin-top:0.6rem">Safety is not a policy. It's a <em>promise.</em></h1>
    <p class="hero-lead">Second Chances exists in part because young people were harmed inside the very places meant to protect them. We hold ourselves to a higher standard, and we are transparent about it.</p>
  </Hero>

  <!-- Principles -->
  <section class="section" aria-labelledby="principles-h">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="label">How we keep people safe</span>
        <h2 class="h2 title" id="principles-h" style="margin-top:0.5rem">Our safeguarding principles.</h2>
        <p class="lead">These commitments guide every interaction, every member of staff, and every volunteer and partner who works with us.</p>
      </div>
      <div class="reassure" data-reveal>
        <div><h4>The young person comes first</h4><p>The safety, dignity, and wishes of the young person guide every decision. We do not act over their heads.</p></div>
        <div><h4>Believe, and act</h4><p>When someone tells us they have been harmed, we listen, we believe, and we respond, sensitively and without delay.</p></div>
        <div><h4>Consent and control</h4><p>Nothing about a young person is shared or actioned without their informed consent, except where there is a serious risk of harm.</p></div>
        <div><h4>Clear boundaries</h4><p>Every member of staff and volunteer signs and works within a code of conduct that protects young people from harm.</p></div>
        <div><h4>Vetted people</h4><p>Those who work directly with young people are screened, referenced, and trained before they begin.</p></div>
        <div><h4>Always accountable</h4><p>Concerns are recorded, reviewed, and escalated to the authorities where required. We hold ourselves open to scrutiny.</p></div>
      </div>
    </div>
  </section>

  <!-- Report a concern -->
  <section id="report" aria-labelledby="report-h" style="scroll-margin-top:5.5rem">
    <article class="split-bleed tint" data-reveal>
      <div class="media">
        <img src={u(hands, 1200)} srcset={`${u(hands, 800)} 800w, ${u(hands, 1200)} 1200w`}
             sizes="(max-width: 940px) 100vw, 50vw" width="1200" height="900" loading="lazy"
             alt="Many hands brought together in the centre of a circle." />
      </div>
      <div class="copy"><div class="inner">
        <span class="label" style="color:var(--purplebright-deep)">Report a concern</span>
        <h2 class="h3" id="report-h" style="margin-top:0.4rem">If you're worried, tell us.</h2>
        <p class="lead" style="margin-top:0.9rem">If you are worried about the safety of a young person, or the conduct of anyone connected to Second Chances, please tell us. You can do so confidentially, and anonymously if you prefer.</p>
        <p>If someone is in immediate danger, contact local emergency services first.</p>
        <div class="paybill" style="border-color:var(--purplebright)">
          <div><div class="k">Safeguarding line</div><div class="v" style="font-size:1.25rem">{contact.safeguardingPhone}</div></div>
          <div><div class="k">Confidential email</div><div class="v" style="font-size:1.1rem">{contact.safeguardingEmail}</div></div>
        </div>
        <a class="btn btn-help" href="/get-help" style="margin-top:1.4rem">Report confidentially</a>
      </div></div>
    </article>
  </section>

  <!-- What happens next -->
  <section class="section" aria-labelledby="after-h">
    <div class="wrap measure">
      <span class="label">After you tell us</span>
      <h2 class="h2 title" id="after-h" style="margin-top:0.5rem">What happens next.</h2>
      <ol class="steps" data-reveal>
        <li><span><b>We take it seriously, immediately.</b> Every concern is logged and reviewed by our designated safeguarding lead.</span></li>
        <li><span><b>We keep you informed.</b> We explain what we can do, what we can't, and what happens next, no surprises.</span></li>
        <li><span><b>We act to protect.</b> Where there is risk, we take steps to keep the young person safe and, where required, involve the relevant authorities.</span></li>
        <li><span><b>We follow through.</b> We stay with the situation until it is resolved, and we review what we can learn.</span></li>
      </ol>
    </div>
  </section>

  <!-- Data -->
  <section class="section band" aria-labelledby="data-h">
    <div class="wrap measure">
      <span class="label">Your data</span>
      <h2 class="h2 title" id="data-h" style="margin-top:0.5rem">Handled with care.</h2>
      <p class="lead" style="margin-top:0.9rem">Many people share painful, private things with us. We treat that trust as sacred.</p>
      <div class="faq">
        <details>
          <summary>What do you do with what I share?</summary>
          <p>We store it securely and use it only to support you. We follow Kenya's Data Protection Act (2019): your information is never sold, and never shared without your consent except where the law requires it to protect someone from harm.</p>
        </details>
        <details>
          <summary>Can I stay anonymous?</summary>
          <p>Yes. You can reach out, report a concern, or ask for help without giving your name. You decide how much to share, and when.</p>
        </details>
        <details>
          <summary>Can I ask you to delete my information?</summary>
          <p>Yes. You can ask to see what we hold about you, correct it, or have it deleted, at any time. Just contact us.</p>
        </details>
      </div>
      <p class="small muted" style="margin-top:1.4rem">Full documents: Safeguarding and Child Protection Policy, Code of Conduct, Privacy and Data Protection Notice <span style="color:var(--ink-faint)">(to be linked).</span></p>
    </div>
  </section>

  <!-- Closing -->
  <section class="section band-ink center" aria-labelledby="safe-close-h">
    <div class="wrap measure">
      <p class="display" id="safe-close-h">If something happened to you, it was never your fault, and it's never too late to <em>tell.</em></p>
      <div class="hero-cta closing-cta-buttons" style="justify-content:center">
        <a class="btn btn-help btn-lg" href="/get-help">Talk to someone safe</a>
      </div>
    </div>
  </section>
</BaseLayout>
