---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { contact, site } from "../config";

// Rendered on-demand so the form's success state (?sent=1) works.
export const prerender = false;
const sent = Astro.url.searchParams.get("sent") === "1";

const u = (id: string, w: number) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&q=80&w=${w}`;
const path = "photo-1567095199396-d4e5588a3cb8";
---
<BaseLayout
  title="Contact"
  description="Get in touch with Second Chances for partnership, media, volunteering, or general enquiries. If you're a young person who needs help, start at Get Help."
>
  <Hero
    variant="soft"
    minHeight="56vh"
    labelledby="contact-h"
    image={u(path, 1600)}
    srcset={`${u(path, 1200)} 1200w, ${u(path, 1600)} 1600w, ${u(path, 2000)} 2000w`}
    alt="An open landscape at dawn."
  >
    <span class="label" style="color:var(--amber-lt)">Contact</span>
    <h1 class="display" id="contact-h" style="margin-top:0.6rem">Let's <em>talk.</em></h1>
    <p class="hero-lead">For partnerships, media, volunteering, or general enquiries. If you're a young person who needs support, you're welcome here too, though <a href="/get-help">Get Help</a> is the gentlest place to start.</p>
  </Hero>

  <section class="section" aria-labelledby="reach-h">
    <div class="wrap split" style="align-items:start">
      <div data-reveal>
        <span class="label">Reach us</span>
        <h2 class="h2 title" id="reach-h" style="margin-top:0.5rem">Get in touch.</h2>
        <div class="reassure" style="grid-template-columns:1fr;gap:1.6rem;margin-top:1.6rem">
          <div>
            <span class="picon sm teal" style="--src:url(/icons/010-communication.png);margin-bottom:0.55rem" aria-hidden="true"></span>
            <h4>General and partnerships</h4>
            <p><a href={`mailto:${contact.generalEmail}`} style="color:var(--teal-deep)">{contact.generalEmail}</a><br />{contact.generalPhone}</p>
          </div>
          <div>
            <span class="picon sm amber" style="--src:url(/icons/015-shield.png);margin-bottom:0.55rem" aria-hidden="true"></span>
            <h4>Safeguarding concerns</h4>
            <p><a href="/safeguarding" style="color:var(--teal-deep)">Report a concern</a> · {contact.safeguardingEmail}<br />{contact.safeguardingPhone}</p>
          </div>
          <div>
            <span class="picon sm teal" style="--src:url(/icons/map.png);margin-bottom:0.55rem" aria-hidden="true"></span>
            <h4>Where to find us</h4>
            <p>{contact.location}<br />A {site.parentOrg} initiative</p>
          </div>
          <div>
            <span class="picon sm teal" style="--src:url(/icons/011-united.png);margin-bottom:0.55rem" aria-hidden="true"></span>
            <h4>Follow along</h4>
            <p>Instagram · X · LinkedIn · Facebook <span class="small muted">(@secondchances)</span></p>
          </div>
        </div>
      </div>

      <div data-reveal="2">
        <span class="label">Send a message</span>
        <h2 class="h2 title" style="margin-top:0.5rem">Write to us.</h2>
        {sent ? (
          <p class="callout teal" style="margin-top:1rem">Thank you. We'll reply within two working days.</p>
        ) : (
          <form method="POST" action="/api/contact" style="display:grid;gap:1.2rem;margin-top:1.4rem">
            <label style="display:grid;gap:.5rem">
              <span class="label" style="color:var(--ink-soft)">Your name</span>
              <input type="text" name="name" placeholder="Name" />
            </label>
            <label style="display:grid;gap:.5rem">
              <span class="label" style="color:var(--ink-soft)">Email <em style="color:var(--amber-deep);font-style:normal">(required)</em></span>
              <input type="email" name="email" required placeholder="you@example.com" />
            </label>
            <label style="display:grid;gap:.5rem">
              <span class="label" style="color:var(--ink-soft)">What's this about?</span>
              <select name="topic">
                <option>General enquiry</option>
                <option>Partnership or funding</option>
                <option>Volunteering / pro bono</option>
                <option>Media</option>
                <option>Refer a young person</option>
              </select>
            </label>
            <label style="display:grid;gap:.5rem">
              <span class="label" style="color:var(--ink-soft)">Message <em style="color:var(--amber-deep);font-style:normal">(required)</em></span>
              <textarea name="message" rows="4" required placeholder="How can we help?"></textarea>
            </label>
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
              <button type="submit" class="btn btn-help btn-lg">Send message</button>
              <span class="small muted">We aim to reply within two working days.</span>
            </div>
          </form>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
