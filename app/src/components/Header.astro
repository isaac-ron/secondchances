---
import { primaryNav, site } from "../config";
import BrandMark from "./BrandMark.astro";
import ExitButton from "./ExitButton.astro";

interface Props { current?: string }
const { current } = Astro.props;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <BrandMark />
      <span class="wordmark"><b>{site.name}</b><small>{site.tagline}</small></span>
    </a>

    <nav class="nav" aria-label="Primary">
      {primaryNav.map((item) => (
        <a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="utility">
      <div class="lang" aria-label="Language">
        <button aria-pressed="true">EN</button><span>/</span><button aria-pressed="false">SW</button>
      </div>
      <a class="btn btn-help" href="/get-help" aria-current={current === "get-help" ? "page" : undefined}>Get Help</a>
      <a class="btn btn-give" href="/get-involved#donate">Donate</a>
      <ExitButton />
      <button class="menu-toggle" aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="#211d18" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</header>
