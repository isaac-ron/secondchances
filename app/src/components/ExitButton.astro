---
// Quick-exit control. `float` renders the always-visible fixed variant (safety:
// reachable without scrolling or JS). href is a real neutral page so it works
// even with JS disabled; app.js upgrades it to history-replacing + single-Esc.
interface Props { float?: boolean }
const { float = false } = Astro.props;
const cls = float ? "exit exit-float" : "exit";
const label = float ? "Leave" : "Leave site";
---
<a class={cls} href="https://www.google.com" data-exit aria-label="Leave this site quickly">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5M9 12h11M16 8l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  {label}
</a>
