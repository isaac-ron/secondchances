---
import { footerColumns, site, contact } from "../config";
const waDigits = contact.whatsapp.replace(/[^0-9]/g, "");
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <span class="wordmark"><b>{site.name}</b><small>{site.tagline}</small></span>
        <p>A second chance for young people leaving care across Kenya. You were never meant to do this alone.</p>
        <div class="foot-contact">
          <span>{contact.location}</span>
          <a href={`https://wa.me/${waDigits}`}>WhatsApp {contact.whatsapp}</a>
          <a href={`mailto:${contact.generalEmail}`}>{contact.generalEmail}</a>
        </div>
      </div>
      {footerColumns.map((col) => (
        <nav aria-label={col.heading}>
          <h4>{col.heading}</h4>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>
    <div class="foot-bottom">
      <span>© 2026 {site.name} · A {site.parentOrg} initiative · <a href="/privacy">Privacy &amp; Data Protection</a></span>
      <a class="exit" href="https://www.google.com" data-exit>Leave this site →</a>
    </div>
  </div>
</footer>
