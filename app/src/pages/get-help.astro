---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import Callout from "../components/Callout.astro";
import { contact } from "../config";

// Rendered on-demand so the form's success state (?sent=1) works.
export const prerender = false;

const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;
const sent = Astro.url.searchParams.get("sent") === "1";
---
<BaseLayout
  title="Get Help"
  description="Reaching out to Second Chances is confidential and simple. WhatsApp, call, or send a private message. You don't have to be in crisis to reach out."
  current="get-help"
>
  <Hero variant="soft" minHeight="68vh" image="https://picsum.photos/seed/sc-calm/1900/1100" alt="Soft morning light">
    <p class="lead kicker-line" style="font-weight:500;margin-bottom:0.6rem">You reached out. That took courage.</p>
    <h1 class="display">Let's take the next&nbsp;step <em>together.</em></h1>
    <p class="lead">There is no wrong way to do this, and no situation too big or too small. Reach out however feels safest for you, you can stay anonymous, and nothing is shared without your say-so.</p>
    <p class="hero-foot">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><path d="M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11Z" stroke="#8a8377" stroke-width="1.7" stroke-linejoin="round" /></svg>
      On a shared or borrowed phone? <a href="#" data-exit>Leave this site now</a>, or press <b>Esc</b>.
    </p>
  </Hero>

  <section class="section" style="padding-top:1rem">
    <div class="wrap">
      <div class="channels">
        <article class="channel">
          <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.6-1.2A9 9 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="M8.5 9.5c0 3 2.5 5.5 5.5 5.5l1-1.4-2-1-.8.8a4.2 4.2 0 0 1-1.9-1.9l.8-.8-1-2L8.5 9.5Z" fill="currentColor" /></svg>
          <h3>WhatsApp us</h3>
          <p>The simplest way to start, message at your own pace, any time. Text or voice note, whatever is easier.</p>
          <a class="btn btn-help go" href="#">Open WhatsApp</a>
        </article>
        <article class="channel">
          <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l2 5-2 1.5a11 11 0 0 0 5 5L15 13l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
          <h3>Call or text</h3>
          <p>Speak to a real person who understands care-leaver experiences. Lines are answered during the day; leave a message any time.</p>
          <a class="btn btn-help go" href={`tel:${contact.generalPhone.replace(/\s/g, "")}`}>{contact.generalPhone}</a>
        </article>
        <article class="channel">
          <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="m4 6 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
          <h3>Send a private message</h3>
          <p>Prefer to write? Use the short form below. Only one field is required, you decide how much to share.</p>
          <a class="btn btn-help go" href="#form">Open the form</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap split split--lead">
      <div>
        <SectionHead title="What happens when you&nbsp;reach&nbsp;out.">
          <p class="lead">No forms, no judgement, no rush. You are in control the whole way, here is exactly what to expect.</p>
        </SectionHead>
      </div>
      <div>
        <ol class="steps">
          <li><span><b>You make contact.</b> Anonymously if you wish. There is no situation we will turn away, and no detail you must give.</span></li>
          <li><span><b>We listen first.</b> A counsellor or caseworker who understands care reaches out to simply hear you, no assessment, no pressure.</span></li>
          <li><span><b>We find the next step together.</b> Counselling, education, legal aid, or just someone in your corner, only what you want, when you're ready.</span></li>
          <li><span><b>We stay.</b> Support doesn't end after one call. A community that will not disappear.</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead title="Our promise to&nbsp;you." />
      <div class="reassure">
        <div>
          <h4>It stays private</h4>
          <p>What you tell us is confidential and handled with care. Nothing is passed on without your consent, except where someone is in danger.</p>
        </div>
        <div>
          <h4>It's never too late</h4>
          <p>Whether you left care last week or years ago, this door is open. You don't have to be in crisis to reach out.</p>
        </div>
        <div>
          <h4>You set the pace</h4>
          <p>Ask one question or share your whole story. Come back tomorrow, next month, or never, there is no wrong choice here.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band" id="form" style="scroll-margin-top:6rem">
    <div class="wrap measure">
      <SectionHead title="Send a private&nbsp;message.">
        <p class="lead">Tell us as little or as much as you like.</p>
      </SectionHead>

      {sent ? (
        <p class="callout teal">Thank you for trusting us. Someone will read this with care.</p>
      ) : (
        <form method="POST" action="/api/get-help" style="display:grid;gap:1.3rem">
          <label style="display:grid;gap:.5rem">
            <span style="font-family:var(--ui);text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;color:var(--ink-soft)">What's on your mind? <em style="color:var(--amber-deep);font-style:normal">(required)</em></span>
            <textarea name="message" rows="4" required placeholder="You can write anything. Even just 'I don't know where to start' is enough." style="font:inherit;padding:.9rem 1rem;border:1px solid var(--line);background:#fff;border-radius:2px;resize:vertical"></textarea>
          </label>
          <label style="display:grid;gap:.5rem">
            <span style="font-family:var(--ui);text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;color:var(--ink-soft)">How can we reach you? <em style="font-style:italic;color:var(--ink-faint)">(optional, leave blank to stay anonymous)</em></span>
            <input type="text" name="contact" placeholder="Phone, WhatsApp, or email, only if you want a reply" style="font:inherit;padding:.9rem 1rem;border:1px solid var(--line);background:#fff;border-radius:2px" />
          </label>
          {sitekey && <div class="cf-turnstile" data-sitekey={sitekey}></div>}
          <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
            <button type="submit" class="btn btn-help btn-lg">Send privately</button>
            <span class="small muted">Encrypted in transit, stored securely, never sold or shared.</span>
          </div>
        </form>
      )}
    </div>
  </section>

  <section class="section center">
    <div class="wrap measure">
      <Callout variant="teal" class="not-ready">Not ready to talk yet? That's okay. You can read through practical guides on documentation, housing, work and your rights, quietly, on your own, no contact needed.</Callout>
      <a class="link-arrow" href="/resources">Browse resources and guides →</a>
    </div>
  </section>

  {sitekey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
